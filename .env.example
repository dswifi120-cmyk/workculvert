# PostgreSQL (Neon/Supabase production URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Legacy Firebase keys (optional, not required for current worker/admin flow)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin access
# Production-এ নিজের fixed admin email + 6 digit code দিন
ADMIN_EMAIL=admin@workculvert.com
ADMIN_OTP_CODE=246810

# Optional future SMS provider flag
# যদি আসল SMS service integrate করেন, server এই env দেখে demo OTP দেখানো বন্ধ করতে পারে
SMS_PROVIDER=
